{
  "id": "ahg_control_center",
  "title": "AHG Control Center",
  "description": "Native ID7 dashboard with session-armed stock MG1 exhaust and ambient-colour testing. ASD/start-stop are simulation-only on stock software.",
  "version": "1.1.1",
  "vendor": "After Hours Garage",
  "license": "MIT",
  "loggingId": "AHG1",
  "iconGlyph": "AHG",
  "mguHmi": [
    "ID7"
  ],
  "memoryKB": 131072,
  "cpuLimit": 30,
  "signals": {
    "de.bmw.infotainment.vehicle.CDS": {
      "_optional": "RPM and engine temperatures unavailable",
      "statusEngineSpeed2": "rs",
      "statusEngineTemperature": "rs"
    },
    "de.bmw.infotainment.vehicle.Vehicle2": {
      "_optional": "Speed unavailable",
      "statusCarSpeed2": "rs"
    },
    "com.harman.infotainment.systemfunctions.tasu.tasu.InternalTasu": {
      "_optional": "Vehicle diagnostic controls unavailable",
      "_instances": "SystemFunctionsInternalTasuInst1",
      "_methods": [
        "sendTasuRequest"
      ],
      "_broadcasts": [
        "sendTasuResponse"
      ]
    },
    "de.bmw.infotainment.misc.ComfortFunctionIuK": {
      "_optional": "Car ambient-colour control unavailable",
      "ambientLightInteriorColour": "w",
      "statusAmbientLightInteriorColour": "rs"
    },
    "de.bmw.infotainment.drivingexcitement.FES": {
      "_optional": "Driving-mode display unavailable",
      "statusFESVehicleDynamicSwitchHMI": "rs"
    }
  },
  "screens": [
    {
      "name": "MAIN",
      "kind": "canvas",
      "title": "AHG Control Center",
      "buttons": [
        [
          "BTN_PAGE",
          "Next page"
        ],
        [
          "BTN_PREV",
          "Previous page"
        ],
        [
          "BTN_SETTINGS",
          "Settings"
        ]
      ]
    }
  ],
  "settings": [
